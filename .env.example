# ============================================================
#  Weather ETL Pipeline — Environment Variables Template
# ============================================================
#  Copy this file to .env and fill in real values.
#  The .env file is listed in .gitignore and will never be
#  committed to version control.
# ============================================================

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# --- Airflow (set via airflow_settings.yaml locally) ---
# AIRFLOW__CORE__FERNET_KEY=<generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
# AIRFLOW__WEBSERVER__SECRET_KEY=<random string>

# --- Open-Meteo API ---
# No API key required — Open-Meteo is free and open.
# The base URL is configured in airflow_settings.yaml under conn_id: open_meteo_api
OPEN_METEO_BASE_URL=https://api.open-meteo.com
